# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# Conexión a PostgreSQL (por ejemplo Neon, Supabase o local)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/mostrador"

# Clave para firmar la sesión (cadena larga y aleatoria)
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Primer administrador (lo usa el seed para crearlo)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambiar-esta-contraseña"
