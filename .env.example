# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# Conexión a PostgreSQL (por ejemplo Neon, Supabase o local)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/mostrador"

# Primer administrador (lo crea `npm run db:seed`)
ADMIN_NOMBRE="Administrador"
ADMIN_ACCESO="admin@ejemplo.com"
ADMIN_CONTRASENA="cambiar-esta-contraseña"
