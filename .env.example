# Copiar como .env (cp .env.example .env). El archivo .env NUNCA se sube al repositorio.
# Los valores de este ejemplo sirven para desarrollo local; en Vercel se cargan valores reales.

# Base de datos
# Desarrollo: archivo SQLite local. Producción: la URL de Turso (libsql://<base>-<usuario>.turso.io)
DATABASE_URL="file:./local.db"
# Solo en producción (Turso). En desarrollo se deja vacío.
DATABASE_AUTH_TOKEN=""

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# En producción generá uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="desarrollo-cambiar-este-secreto-por-uno-largo-y-aleatorio"

# Usuarios de prueba que crea `pnpm run db:seed` (uno por rol)
SEED_ADMIN_NOMBRE="Laura Méndez"
SEED_ADMIN_EMAIL="admin@mostrador.test"
SEED_ADMIN_PASSWORD="admin1234"
SEED_VENDEDOR_NOMBRE="Pablo Ruiz"
SEED_VENDEDOR_EMAIL="vendedor@mostrador.test"
SEED_VENDEDOR_PASSWORD="vendedor1234"
