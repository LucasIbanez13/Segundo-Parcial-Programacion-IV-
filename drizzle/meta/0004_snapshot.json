        "facturas_total_positivo": {
          "name": "facturas_total_positivo",
          "value": "\"facturas\".\"total\" > 0"
        },
        "facturas_forma_valida": {
          "name": "facturas_forma_valida",
          "value": "\"facturas\".\"forma\" IN ('contado', 'tarjeta', 'cuenta_corriente')"
        },
        "facturas_estado_valido": {
          "name": "facturas_estado_valido",
          "value": "\"facturas\".\"estado\" IN ('emitida', 'anulada')"
        },
        "facturas_cuenta_con_cliente": {
          "name": "facturas_cuenta_con_cliente",
          "value": "\"facturas\".\"forma\" <> 'cuenta_corriente' OR \"facturas\".\"cliente_id\" IS NOT NULL"
        },
        "facturas_datos_tarjeta": {
          "name": "facturas_datos_tarjeta",
          "value": "(\"facturas\".\"forma\" = 'tarjeta' AND \"facturas\".\"tarjeta_tipo\" IN ('debito', 'credito') AND \"facturas\".\"tarjeta_marca\" IS NOT NULL AND \"facturas\".\"tarjeta_ultimos4\" GLOB '[0-9][0-9][0-9][0-9]')\n        OR (\"facturas\".\"forma\" <> 'tarjeta' AND \"facturas\".\"tarjeta_tipo\" IS NULL AND \"facturas\".\"tarjeta_marca\" IS NULL AND \"facturas\".\"tarjeta_ultimos4\" IS NULL)"
        },
        "facturas_monto_recibido": {
          "name": "facturas_monto_recibido",
          "value": "(\"facturas\".\"forma\" = 'contado' AND \"facturas\".\"monto_recibido\" >= \"facturas\".\"total\") OR (\"facturas\".\"forma\" <> 'contado' AND \"facturas\".\"monto_recibido\" IS NULL)"
        },
        "facturas_anulacion_con_motivo": {
          "name": "facturas_anulacion_con_motivo",
          "value": "\"facturas\".\"estado\" = 'emitida' OR (\"facturas\".\"motivo_anulacion\" IS NOT NULL AND \"facturas\".\"anulada_en\" IS NOT NULL AND \"facturas\".\"anulada_por_id\" IS NOT NULL)"
        }
      }
